# Session signing secret (REQUIRED). Generate: openssl rand -base64 32
AUTH_SECRET="change-me"

# Admin password hash (REQUIRED). Generate: npm run gen:password "yourpassword"
ADMIN_PASSWORD_HASH=""

# Where the editable config.json lives.
# Default in prod: /app/data/config.json ; dev: ./data/config.json
# CONFIG_PATH="./data/config.json"

NODE_ENV="development"
