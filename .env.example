# =============================================================================
# MARIUS PORTFOLIO - ENVIRONMENT VARIABLES
# =============================================================================

# SQLite database (file-based, no external DB needed)
DATABASE_URL="file:./prisma/dev.db"

# Environment mode
NODE_ENV="development"

# NextAuth secret (REQUIRED — generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here-change-this-in-production"

# Application base URL
NEXTAUTH_URL="http://localhost:3000"

# Required behind reverse proxies / Cloudflare in production
AUTH_TRUST_HOST="true"
