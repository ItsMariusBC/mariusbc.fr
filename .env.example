# =============================================================================
# MARIUS PORTFOLIO - ENVIRONMENT VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# Local development: postgresql://postgres:password@localhost:5432/marius_portfolio
# Railway production: Automatically provided by Railway PostgreSQL addon
DATABASE_URL="postgresql://postgres:password@localhost:5432/marius_portfolio"

# -----------------------------------------------------------------------------
# APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
# Environment mode (development, production, test)
NODE_ENV="development"

# -----------------------------------------------------------------------------
# BETTER AUTH CONFIGURATION
# -----------------------------------------------------------------------------
# Secret key for Better Auth session encryption (REQUIRED)
# Generate a secure random string for production
# Use: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here-change-this-in-production"

# Base URL for the application (REQUIRED for Better Auth)
# Development: http://localhost:3000
# Production: https://your-domain.railway.app (Railway provides this)
NEXTAUTH_URL="http://localhost:3000"