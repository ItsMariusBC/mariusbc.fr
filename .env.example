# Session signing secret (REQUIRED). Generate: openssl rand -base64 32
AUTH_SECRET="change-me"

# Admin password (REQUIRED) — base64 of the bcrypt hash (no "$" to escape).
# Generate with: npm run gen:password "yourpassword"
ADMIN_PASSWORD_HASH_B64=""

# Where the editable config.json lives.
# Default in prod: /app/data/config.json ; dev: ./data/config.json
# CONFIG_PATH="./data/config.json"

# Optional — PostHog analytics (production only)
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

NODE_ENV="development"
